{
  "name": "nawa-finance-redeemer",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram alert bot for pending NAWA vault redeem requests (Ethereum + ZigChain)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@cosmjs/encoding": "^0.39.0",
    "@cosmjs/proto-signing": "^0.39.0",
    "cosmjs-types": "^0.11.0",
    "dotenv": "^18.0.8",
    "ethers": "^6.17.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
