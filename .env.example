# Telegram
# Bot token from @BotFather (keep secret, never commit)
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs; every alert goes to all of them, e.g. 123456789,-1001234567890
TELEGRAM_CHAT_IDS=
# true = print alerts to logs only, never send to Telegram
DRY_RUN=true

# Ethereum
ETHEREUM_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
ETHEREUM_HTTP_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Numbered vaults: add ETH_VAULT_02_*, ETH_VAULT_03_* ... with all four fields
ETH_VAULT_01_NAME=NAWA USDT Vault
ETH_VAULT_01_ADDRESS=0x6FE78B942C566fE2b8D0881cf3577C1B1511F204
ETH_VAULT_01_SYMBOL=USDT
ETH_VAULT_01_DECIMALS=6

# ZigChain
ZIGCHAIN_RPC_URL=https://internal-bots-rpc.wickhub.cc
ZIGCHAIN_WS_URL=wss://internal-bots-rpc.wickhub.cc/websocket
# Optional LCD/REST endpoint for CosmWasm smart queries. Empty = use RPC abci_query.
ZIGCHAIN_LCD_URL=
ZIG_MEMPOOL_POLL_MS=500

# Numbered vaults: add ZIG_VAULT_02_*, ZIG_VAULT_03_* ... with all four fields
ZIG_VAULT_01_NAME=NAWA USDC Vault
ZIG_VAULT_01_ADDRESS=zig1fn4rrr5knlg93nf3wyme9fzmgve3fftxu5l7wv90llp77mwg7ctq2lfwtd
ZIG_VAULT_01_SYMBOL=USDC
ZIG_VAULT_01_DECIMALS=6

# Dedupe / startup / logging
DEDUPE_TTL_MINUTES=1440
ALERT_EXISTING_MEMPOOL_ON_START=false
# debug | info | warn | error
LOG_LEVEL=info
